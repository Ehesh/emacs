;;; post-init.el --- E6's config (tangled from Config.org) -*- lexical-binding: t; -*-
;;; Commentary:
;;  DO NOT EDIT.  This file is generated by tangling Config.org.
;;  Edit Config.org instead; saving it re-tangles this file.
;;; Code:

(defun e6/auto-tangle-config ()
  "Tangle the Emacs `Config.org' when it is saved."
  (when (and buffer-file-name
             (string-equal (file-name-nondirectory buffer-file-name)
                           "Config.org"))
    (let ((org-confirm-babel-evaluate nil)
          (message-log-max nil)
          (inhibit-message t))
      (require 'org)
      (org-babel-tangle))))

(add-hook 'after-save-hook #'e6/auto-tangle-config)

