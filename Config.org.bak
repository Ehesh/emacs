** Utility Functions

#+begin_src emacs-lisp
(defun e6/github-code-search ()
  "Search GitHub code for a given language and query."
  (interactive)
  (let ((language (completing-read "Language: "
                                   '("Emacs Lisp" "Python" "Clojure" "R")))
        (code (read-string "Code: ")))
    (browse-url
     (concat "https://github.com/search?l=" language "&type=code&q=" code))))

(defun e6/search-engine ()
  "Search various search engines."
  (interactive)
  (let ((engine (completing-read "Engine: " '("Google" "Arch Wiki" "Wikipedia")))
        (query (read-string "Query: ")))
    (pcase engine
      ("Google"
       (browse-url (concat "https://www.google.com/search?q=" query)))
      ("Arch Wiki"
       (browse-url (concat "https://wiki.archlinux.org/index.php?search=" query)))
      ("Wikipedia"
       (browse-url (concat "https://en.wikipedia.org/wiki/Special:Search/" query))))))
#+end_src
